+//! Demonstrates the `Algorithm::state_snapshot` accessor added by this patch.
+//!
+//! Runs one local stage-router turn against a session id, then dumps the retained
+//! per-session state as JSON. Run with:
+//!
+//!     cargo run -p switchyard-libsy --example state_snapshot
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use futures::StreamExt;
+use switchyard_libsy::{Algorithm, PickerMode, RuntimeModels, StageRouter, StageRouterConfig, Step};
+use switchyard_protocol::{text_request, Category, Metadata, ModelId, Request};
+
+#[tokio::main]
+async fn main() {
+    let algorithm = Arc::new(
+        StageRouter::new(StageRouterConfig::new(PickerMode::EfficientFirst, 0.5))
+            .expect("stage router"),
+    );
+
+    let models = Arc::new(RuntimeModels::new(HashMap::from([
+        (Category::Capable, vec![ModelId::from("m/capable")]),
+        (Category::Efficient, vec![ModelId::from("m/efficient")]),
+        (
+            Category::Any,
+            vec![ModelId::from("m/capable"), ModelId::from("m/efficient")],
+        ),
+    ])));
+
+    let session = "session-1";
+    let request = Request {
+        llm_request: text_request(Some("auto".to_string()), "hello"),
+        raw_request: None,
+        metadata: Some(Metadata {
+            session_id: Some(session.to_string()),
+            ..Metadata::default()
+        }),
+    };
+
+    let mut stream = algorithm.clone().run_stream(request, models);
+    while let Some(step) = stream.next().await {
+        match step {
+            Ok(Step::Done(done)) => println!("selected: {:?}", done.selected_model_ids),
+            Ok(other) => println!("step: {}", step_kind(&other)),
+            Err(error) => println!("error: {error}"),
+        }
+    }
+    drop(stream);
+
+    match algorithm.state_snapshot(session).await {
+        Some(state) => println!("state_snapshot({session}) = {}", serde_json::to_string_pretty(&state).unwrap()),
+        None => println!("state_snapshot({session}) = <none>"),
+    }
+    println!("state_snapshot(\"absent\") = {:?}", algorithm.state_snapshot("absent").await);
+}
+
+fn step_kind(step: &Step) -> &'static str {
+    match step {
+        Step::CallModel(_) => "CallModel",
+        Step::CallDecision(_) => "CallDecision",
+        Step::Done(_) => "Done",
+    }
+}
