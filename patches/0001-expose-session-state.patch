+impl<S> FallThrough<S>
+where
+    S: Serialize + Send + Sync + 'static,
+{
+    /// JSON snapshot of one session's retained state, for hosts that inspect or
+    /// persist routing decisions.
+    pub async fn session_state_json(&self, session_id: &str) -> Option<Value> {
+        let states = self.session_states.as_ref()?;
+        let state = {
+            let states = states.lock();
+            states.get(session_id).map(|session| Arc::clone(&session.state))
+        }?;
+        let state = state.lock().await;
+        serde_json::to_value(&*state).ok()
+    }
+}
+
